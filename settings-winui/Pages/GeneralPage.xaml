<Page
    x:Class="RadialMenu.Settings.Pages.GeneralPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:tk="using:CommunityToolkit.WinUI.Controls"
    xmlns:models="using:RadialMenu.Settings.Models">

    <ScrollViewer>
        <StackPanel Spacing="4" Padding="36,8,36,36" MaxWidth="1000" HorizontalAlignment="Stretch">
            <TextBlock Text="全般" Style="{StaticResource TitleTextBlockStyle}" Margin="0,0,0,12" />

            <TextBlock Text="動作" Style="{StaticResource BodyStrongTextBlockStyle}" Margin="1,8,0,4" />
            <tk:SettingsCard Header="メニューを有効にする"
                             Description="オフにすると、起動操作でメニューが出なくなります">
                <tk:SettingsCard.HeaderIcon><FontIcon Glyph="&#xE7E8;" /></tk:SettingsCard.HeaderIcon>
                <ToggleSwitch IsOn="{x:Bind Cfg.Enabled, Mode=TwoWay}" />
            </tk:SettingsCard>
            <tk:SettingsCard Header="長押しの時間"
                             Description="起動操作をしてからメニューが出るまでの時間(ミリ秒、80〜1500)">
                <tk:SettingsCard.HeaderIcon><FontIcon Glyph="&#xE916;" /></tk:SettingsCard.HeaderIcon>
                <NumberBox Value="{x:Bind Cfg.HoldMsValue, Mode=TwoWay}" Minimum="80" Maximum="1500"
                           SmallChange="10" LargeChange="100" SpinButtonPlacementMode="Inline" Width="160" />
            </tk:SettingsCard>

            <TextBlock Text="起動方法" Style="{StaticResource BodyStrongTextBlockStyle}" Margin="1,20,0,4" />
            <TextBlock TextWrapping="Wrap" Margin="1,0,0,6"
                       Style="{StaticResource CaptionTextBlockStyle}"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       Text="メニューを開く操作です。複数登録でき、どれでも開けます。キーは他のアプリにもそのまま伝わるので、修飾キーとの組み合わせがおすすめです。文字キーを単独で使うと、メニューが出るまでの間、その文字が連続入力されます。" />
            <ItemsControl ItemsSource="{x:Bind Cfg.Activation.Triggers}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="models:Trigger">
                        <tk:SettingsCard Header="{x:Bind Display, Mode=OneWay}" Margin="0,0,0,4">
                            <tk:SettingsCard.HeaderIcon><FontIcon Glyph="&#xE765;" /></tk:SettingsCard.HeaderIcon>
                            <Button Content="削除" Click="DeleteTrigger_Click" />
                        </tk:SettingsCard>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,4,0,0">
                <Button Content="キーの組み合わせを記録して追加" Click="StartCapture_Click" />
                <ComboBox x:Name="MouseButtonCombo" SelectedIndex="0" MinWidth="180">
                    <ComboBoxItem Content="マウス 中ボタン" />
                    <ComboBoxItem Content="マウス 右ボタン" />
                    <ComboBoxItem Content="マウス サイドボタン1" />
                    <ComboBoxItem Content="マウス サイドボタン2" />
                </ComboBox>
                <Button Content="マウスボタンを追加" Click="AddMouseTrigger_Click" />
            </StackPanel>
            <Border x:Name="CaptureBox" Visibility="Collapsed" IsTabStop="True"
                    BorderBrush="{ThemeResource AccentFillColorDefaultBrush}" BorderThickness="1"
                    CornerRadius="4" Padding="16" Margin="0,8,0,0"
                    KeyDown="CaptureBox_KeyDown" KeyUp="CaptureBox_KeyUp">
                <TextBlock x:Name="CaptureStatus" TextWrapping="Wrap"
                           Text="キーを押してください。組み合わせを全部離すと確定します。Esc でキャンセルします。" />
            </Border>

            <TextBlock Text="外観" Style="{StaticResource BodyStrongTextBlockStyle}" Margin="1,20,0,4" />
            <tk:SettingsCard Header="メニューのサイズ" Description="画面のスケールに対する倍率">
                <tk:SettingsCard.HeaderIcon><FontIcon Glyph="&#xE740;" /></tk:SettingsCard.HeaderIcon>
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <Slider Width="240" Minimum="60" Maximum="200" StepFrequency="5"
                            Value="{x:Bind Cfg.ScaleValue, Mode=TwoWay}" />
                    <TextBlock Text="{x:Bind Cfg.ScaleText, Mode=OneWay}" VerticalAlignment="Center" MinWidth="44" />
                </StackPanel>
            </tk:SettingsCard>
            <tk:SettingsCard Header="テーマ" Description="メニューの配色">
                <tk:SettingsCard.HeaderIcon><FontIcon Glyph="&#xE706;" /></tk:SettingsCard.HeaderIcon>
                <ComboBox SelectedIndex="{x:Bind Cfg.ThemeIndex, Mode=TwoWay}" MinWidth="200">
                    <ComboBoxItem Content="Windows の設定に合わせる" />
                    <ComboBoxItem Content="ライト" />
                    <ComboBoxItem Content="ダーク" />
                </ComboBox>
            </tk:SettingsCard>
            <tk:SettingsCard Header="アクセント色" Description="ホバー中の項目の縁取りなどに使う色">
                <tk:SettingsCard.HeaderIcon><FontIcon Glyph="&#xE790;" /></tk:SettingsCard.HeaderIcon>
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <TextBox PlaceholderText="#0078d4" Width="120"
                             Visibility="{x:Bind Cfg.UseCustomAccent, Mode=OneWay}"
                             Text="{x:Bind Cfg.AccentText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    <ToggleSwitch IsOn="{x:Bind Cfg.UseAutoAccent, Mode=TwoWay}"
                                  OnContent="Windows の色" OffContent="指定した色" />
                </StackPanel>
            </tk:SettingsCard>

            <TextBlock Text="システム" Style="{StaticResource BodyStrongTextBlockStyle}" Margin="1,20,0,4" />
            <tk:SettingsCard Header="Windows 起動時に自動で実行"
                             Description="サインインしたときに Radial Menu を常駐させます">
                <tk:SettingsCard.HeaderIcon><FontIcon Glyph="&#xE7E8;" /></tk:SettingsCard.HeaderIcon>
                <ToggleSwitch x:Name="StartupToggle" />
            </tk:SettingsCard>
            <tk:SettingsCard Header="設定ファイル" Description="{x:Bind ConfigPath}">
                <tk:SettingsCard.HeaderIcon><FontIcon Glyph="&#xE8A5;" /></tk:SettingsCard.HeaderIcon>
                <Button Content="フォルダーを開く" Click="RevealConfig_Click" />
            </tk:SettingsCard>
            <tk:SettingsCard Header="すべての設定を既定に戻す"
                             Description="項目・段・キー割り当てを含め、最初の状態に戻します">
                <tk:SettingsCard.HeaderIcon><FontIcon Glyph="&#xE777;" /></tk:SettingsCard.HeaderIcon>
                <Button Content="既定に戻す" Click="Reset_Click" />
            </tk:SettingsCard>
        </StackPanel>
    </ScrollViewer>
</Page>
