<Page
    x:Class="RadialMenu.Settings.Pages.AboutPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:tk="using:CommunityToolkit.WinUI.Controls">

    <ScrollViewer>
        <StackPanel Spacing="4" Padding="36,8,36,36" MaxWidth="1000" HorizontalAlignment="Stretch">
            <TextBlock Text="情報" Style="{StaticResource TitleTextBlockStyle}" Margin="0,0,0,12" />

            <tk:SettingsCard Header="Radial Menu" Description="{x:Bind VersionText}">
                <tk:SettingsCard.HeaderIcon><FontIcon Glyph="&#xE946;" /></tk:SettingsCard.HeaderIcon>
            </tk:SettingsCard>

            <TextBlock Text="更新" Style="{StaticResource BodyStrongTextBlockStyle}" Margin="1,20,0,4" />
            <tk:SettingsCard Header="更新元の URL"
                             Description="この URL の下の latest.json を見て、新しい版を探します">
                <tk:SettingsCard.HeaderIcon><FontIcon Glyph="&#xE71B;" /></tk:SettingsCard.HeaderIcon>
                <TextBox Width="420" PlaceholderText="https://github.com/OWNER/REPO/releases/latest/download"
                         Text="{x:Bind Cfg.UpdateUrl, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            </tk:SettingsCard>
            <tk:SettingsCard x:Name="StatusCard" Header="更新の状態">
                <tk:SettingsCard.HeaderIcon><FontIcon Glyph="&#xE895;" /></tk:SettingsCard.HeaderIcon>
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <ProgressRing x:Name="Ring" Width="20" Height="20" IsActive="False" />
                    <Button x:Name="CheckButton" Content="更新を確認" Click="Check_Click" />
                    <Button x:Name="UpdateButton" Content="更新する" Click="Update_Click"
                            Style="{StaticResource AccentButtonStyle}" Visibility="Collapsed" />
                </StackPanel>
            </tk:SettingsCard>
            <ProgressBar x:Name="DownloadBar" Minimum="0" Maximum="1" Visibility="Collapsed" Margin="0,4,0,0" />
            <TextBlock x:Name="Message" TextWrapping="Wrap" Margin="1,4,0,0"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        </StackPanel>
    </ScrollViewer>
</Page>
