<Page
    x:Class="RadialMenu.Settings.Pages.LayersPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:RadialMenu.Settings.Models">

    <Page.Resources>

        <!-- アイコン選択の一覧表示 -->
        <DataTemplate x:Key="IconTemplate" x:DataType="models:IconEntry">
            <StackPanel Orientation="Horizontal" Spacing="12">
                <FontIcon Glyph="{x:Bind Glyph}" FontSize="18" />
                <TextBlock Text="{x:Bind Name}" VerticalAlignment="Center" />
            </StackPanel>
        </DataTemplate>

        <!-- 項目 1 つ分の編集カード -->
        <DataTemplate x:Key="ItemTemplate" x:DataType="models:Item">
            <Expander HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Margin="0,0,0,4">
                <Expander.Header>
                    <Grid ColumnSpacing="14" Padding="0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <FontIcon Glyph="{x:Bind Icon, Mode=OneWay}" FontSize="20" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="{x:Bind Label, Mode=OneWay}" />
                            <TextBlock Text="{x:Bind Subtitle, Mode=OneWay}"
                                       Style="{StaticResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                        <ToggleSwitch Grid.Column="2" IsOn="{x:Bind Enabled, Mode=TwoWay}"
                                      OnContent="" OffContent="" MinWidth="0" />
                    </Grid>
                </Expander.Header>
                <StackPanel Spacing="12" Padding="4,4,4,8">
                    <TextBox Header="名前" Text="{x:Bind Label, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    <ComboBox Header="動作" MinWidth="220" SelectedIndex="{x:Bind KindIndex, Mode=TwoWay}">
                        <ComboBoxItem Content="キーを送信" />
                        <ComboBoxItem Content="プログラムを実行" />
                        <ComboBoxItem Content="URL を開く" />
                    </ComboBox>
                    <TextBox Header="{x:Bind ValueHeader, Mode=OneWay}"
                             PlaceholderText="{x:Bind ValuePlaceholder, Mode=OneWay}"
                             Visibility="{x:Bind IsNotRun, Mode=OneWay}"
                             Text="{x:Bind Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    <StackPanel Spacing="8" Visibility="{x:Bind IsRun, Mode=OneWay}">
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox Header="プログラムのパス"
                                     PlaceholderText="例: C:\Program Files\...\app.exe"
                                     Text="{x:Bind RunPath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            <Button Grid.Column="1" Content="参照..." VerticalAlignment="Bottom"
                                    Click="BrowseRunPath_Click" />
                        </Grid>
                        <TextBox Header="引数(任意)"
                                 PlaceholderText="例: --fullscreen"
                                 Text="{x:Bind RunArgs, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>
                    <TextBox Header="サブタイトル(空欄ならキーや URL を表示)"
                             Text="{x:Bind Hint, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <ComboBox Header="アイコン" MinWidth="220"
                                  ItemsSource="{x:Bind models:IconCatalog.All}"
                                  ItemTemplate="{StaticResource IconTemplate}"
                                  SelectedIndex="{x:Bind IconIndex, Mode=TwoWay}" />
                        <TextBox Header="文字コード(16進・任意)" Width="170" PlaceholderText="E838"
                                 Text="{x:Bind IconHex, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Click="{x:Bind MoveUp}">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE70E;" FontSize="14" /><TextBlock Text="上へ" />
                            </StackPanel>
                        </Button>
                        <Button Click="{x:Bind MoveDown}">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE70D;" FontSize="14" /><TextBlock Text="下へ" />
                            </StackPanel>
                        </Button>
                        <Button Click="{x:Bind Delete}">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE74D;" FontSize="14" /><TextBlock Text="削除" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </StackPanel>
            </Expander>
        </DataTemplate>

        <!-- 選択中の段の編集 -->
        <DataTemplate x:Key="LayerDetailTemplate" x:DataType="models:Layer">
            <StackPanel Spacing="14">
                <TextBox Header="段の名前" MaxWidth="420" HorizontalAlignment="Left"
                         Text="{x:Bind Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                <StackPanel Spacing="4">
                    <ComboBox Header="この段に切り替えるキー" MinWidth="280"
                              ItemsSource="{x:Bind models:KeyChoices.Labels}"
                              SelectedIndex="{x:Bind KeyIndex, Mode=TwoWay}" />
                    <TextBlock TextWrapping="Wrap" Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               Text="メニューを開いたままこのキーを押すと、この段に切り替わります。同じキーを複数の段に割り当てた場合は、上の段が優先されます。「自動」は段の順番どおり 1 段目＝1、2 段目＝2… です。" />
                </StackPanel>
                <TextBlock Text="項目" Style="{StaticResource BodyStrongTextBlockStyle}" Margin="0,6,0,0" />
                <ItemsControl ItemsSource="{x:Bind Items}" ItemTemplate="{StaticResource ItemTemplate}" />
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <Button Click="{x:Bind AddItem}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE710;" FontSize="14" /><TextBlock Text="項目を追加" />
                        </StackPanel>
                    </Button>
                    <TextBlock Text="1 つの段に 2〜12 個まで" VerticalAlignment="Center"
                               Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>
            </StackPanel>
        </DataTemplate>

    </Page.Resources>

    <Grid Padding="36,8,36,24" ColumnSpacing="24" RowSpacing="12">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="280" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock Grid.ColumnSpan="2" Text="段とアイテム" Style="{StaticResource TitleTextBlockStyle}" />

        <!-- 左: 段の一覧 -->
        <Grid Grid.Row="1" RowSpacing="8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <StackPanel Orientation="Horizontal" Spacing="4">
                <Button Click="AddLayer_Click" ToolTipService.ToolTip="段を追加">
                    <FontIcon Glyph="&#xE710;" FontSize="14" />
                </Button>
                <Button Click="DeleteLayer_Click" ToolTipService.ToolTip="選択中の段を削除">
                    <FontIcon Glyph="&#xE74D;" FontSize="14" />
                </Button>
                <Button Click="MoveLayerUp_Click" ToolTipService.ToolTip="上へ">
                    <FontIcon Glyph="&#xE70E;" FontSize="14" />
                </Button>
                <Button Click="MoveLayerDown_Click" ToolTipService.ToolTip="下へ">
                    <FontIcon Glyph="&#xE70D;" FontSize="14" />
                </Button>
            </StackPanel>
            <ListView x:Name="LayerList" Grid.Row="1" SelectionMode="Single"
                      ItemsSource="{x:Bind Cfg.Layers}">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="models:Layer">
                        <StackPanel Padding="0,8" Spacing="2">
                            <TextBlock Text="{x:Bind Name, Mode=OneWay}" />
                            <TextBlock Text="{x:Bind Summary, Mode=OneWay}"
                                       Style="{StaticResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Grid>

        <!-- 右: 選択中の段 -->
        <ScrollViewer Grid.Row="1" Grid.Column="1">
            <ContentControl Content="{Binding SelectedItem, ElementName=LayerList}"
                            ContentTemplate="{StaticResource LayerDetailTemplate}"
                            HorizontalContentAlignment="Stretch" Padding="0,0,16,24" />
        </ScrollViewer>
    </Grid>
</Page>
