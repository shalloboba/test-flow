<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.22621.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>RadialMenu.Settings</RootNamespace>
    <AssemblyName>RadialMenu.Settings</AssemblyName>
    <Version>0.4.0</Version>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWinUI>true</UseWinUI>
    <EnableMsixTooling>true</EnableMsixTooling>
    <!-- パッケージ化しない(MSIX なし)＋ランタイム同梱。インストーラー(Inno Setup)でそのまま配れる -->
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <SelfContained>true</SelfContained>
    <DefaultLanguage>ja-JP</DefaultLanguage>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.6.250108002" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.26100.1742" />
    <PackageReference Include="CommunityToolkit.WinUI.Controls.SettingsControls" Version="8.1.240916" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="app.ico">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <!-- 本体 (Rust) がビルド済みなら、publish の出力へ自動で同梱する。
       本体が無いときは何もしない (設定アプリ単体のビルドを通すため)。 -->
  <Target Name="CopyHostExeToPublish" AfterTargets="Publish">
    <Copy SourceFiles="..\target\release\RadialMenu.exe"
          DestinationFolder="$(PublishDir)"
          Condition="Exists('..\target\release\RadialMenu.exe')"
          SkipUnchangedFiles="true" />
  </Target>

</Project>
