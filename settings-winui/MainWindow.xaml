<Window
    x:Class="RadialMenu.Settings.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid x:Name="Root">
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- タイトルバー: アイコン・タイトル・検索ボックス -->
        <Grid x:Name="AppTitleBar" Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="150" />
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" Spacing="12" Margin="16,0,0,0" VerticalAlignment="Center">
                <Ellipse Width="16" Height="16" StrokeThickness="3"
                         Stroke="{ThemeResource AccentFillColorDefaultBrush}" />
                <TextBlock Text="Radial Menu の設定" Style="{StaticResource CaptionTextBlockStyle}"
                           VerticalAlignment="Center" />
            </StackPanel>
            <AutoSuggestBox x:Name="SearchBox" Grid.Column="1" PlaceholderText="設定を検索"
                            QueryIcon="Find" MaxWidth="480" Margin="24,0"
                            VerticalAlignment="Center" HorizontalAlignment="Stretch"
                            TextMemberPath="Title"
                            TextChanged="Search_TextChanged"
                            SuggestionChosen="Search_SuggestionChosen"
                            QuerySubmitted="Search_QuerySubmitted" />
        </Grid>

        <NavigationView x:Name="Nav" Grid.Row="1" PaneDisplayMode="Left" OpenPaneLength="260"
                        IsBackButtonVisible="Collapsed" IsSettingsVisible="False"
                        SelectionChanged="Nav_SelectionChanged">
            <NavigationView.MenuItems>
                <NavigationViewItem Content="ホーム" Tag="home">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE80F;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="段とアイテム" Tag="layers">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE81E;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="全般" Tag="general">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE713;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="情報" Tag="about">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE946;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>
            <Frame x:Name="ContentFrame" />
        </NavigationView>
    </Grid>
</Window>
